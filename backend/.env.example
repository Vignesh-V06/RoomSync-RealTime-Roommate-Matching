# Backend environment variables
PORT=5000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=roomsync

# Comma-separated frontend origins. In production, include deployed origins.
FRONTEND_ORIGINS=http://localhost:5173

# Keep false. Email reset now uses the verified OTP flow.
ALLOW_UNVERIFIED_PASSWORD_RESET=false

# Resend transactional email. Verify the sender domain in Resend first.
RESEND_API_KEY=
RESEND_FROM_EMAIL=RoomSync <auth@your-verified-domain.com>
PASSWORD_RESET_OTP_SECRET=replace-with-a-separate-long-random-secret

# Optional one-time admin bootstrap. Keep secrets only in private .env/host settings.
ADMIN_EMAIL=admin.v@gmail.com
ADMIN_PASSWORD=
ADMIN_NAME=RoomSync Administrator
ADMIN_USERNAME=admin.v

# Backend environment variables
PORT=5000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=roomsync

# Comma-separated frontend origins. In production, include deployed origins.
FRONTEND_ORIGINS=http://localhost:5173

# Local development email provider: gmail or resend. Defaults to gmail in development.
EMAIL_PROVIDER=gmail

# Gmail SMTP (recommended for local development). Use a Google App Password, NOT your Google login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_APP_PASSWORD=
# Optional display name/address; if blank, RoomSync sends from SMTP_USER.
SMTP_FROM_EMAIL=

# Optional future production provider. Select with EMAIL_PROVIDER=resend after verifying a sender domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
PASSWORD_RESET_OTP_SECRET=replace-with-a-separate-long-random-secret

# Optional one-time admin bootstrap. Keep secrets only in private .env/host settings.
ADMIN_EMAIL=admin.v@gmail.com
ADMIN_PASSWORD=
ADMIN_NAME=RoomSync Administrator
ADMIN_USERNAME=admin.v

# Backend environment variables
PORT=5000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret

# PostgreSQL / Neon
DATABASE_URL=
DB_SCHEMA=roomsync

# Comma-separated frontend origins. In production, include deployed origins.
FRONTEND_ORIGINS=http://localhost:5173

# Shared email provider used by registration OTP and password-reset OTP.
# Recommended for RoomSync hosting: apps_script (HTTPS relay through your Gmail account).
# Other supported providers: gmail (SMTP) and resend.
EMAIL_PROVIDER=apps_script

# Google Apps Script Web App relay.
# Use the deployed Web App URL ending in /exec.
# The secret must exactly match Script Properties: ROOMSYNC_MAIL_SECRET.
APPS_SCRIPT_EMAIL_URL=
APPS_SCRIPT_EMAIL_SECRET=

# Optional Gmail SMTP provider. Render Free cannot connect to Gmail SMTP ports.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_APP_PASSWORD=
# Optional display name/address; if blank, RoomSync sends from SMTP_USER.
SMTP_FROM_EMAIL=

# Optional Resend provider. A verified sender domain is required for normal production sending.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Shared keyed-hash secret for password reset OTP and new-account email verification.
PASSWORD_RESET_OTP_SECRET=replace-with-a-long-random-secret

# Optional one-time admin bootstrap. Keep secrets only in private .env/host settings.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
ADMIN_USERNAME=

# Backend environment variables
PORT=5000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=roomsync

# Comma-separated frontend origins. In production, include the Vercel production
# URL and any preview origin you intentionally want to allow.
FRONTEND_ORIGINS=http://localhost:5173

# Keep false. The legacy reset route has no email/OTP verification.
ALLOW_UNVERIFIED_PASSWORD_RESET=false

# Optional one-time admin bootstrap (keep these only in local/host secret settings)
ADMIN_EMAIL=admin.v@gmail.com
ADMIN_PASSWORD=
ADMIN_NAME=RoomSync Administrator
ADMIN_USERNAME=admin.v

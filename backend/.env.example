# Backend environment variables
PORT=5000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=roomsync

# Comma-separated frontend origins. In production, include deployed origins.
FRONTEND_ORIGINS=http://localhost:5173

# Initial local test only: onboarding@resend.dev can send only to the Resend account email.
# For other recipients, verify a domain you own in Resend and use a sender on that domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL="RoomSync <onboarding@resend.dev>"
PASSWORD_RESET_OTP_SECRET=replace-with-a-separate-long-random-secret

# Optional one-time admin bootstrap. Keep secrets only in private .env/host settings.
ADMIN_EMAIL=admin.v@gmail.com
ADMIN_PASSWORD=
ADMIN_NAME=RoomSync Administrator
ADMIN_USERNAME=admin.v

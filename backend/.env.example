# Backend environment variables
PORT=
NODE_ENV=
JWT_SECRET=
DB_HOST=localhst
DB_USER=
DB_PASSWORD=
DB_NAME=

# Comma-separated frontend origins. In production, include the Vercel production
# URL and any preview origin you intentionally want to allow.
FRONTEND_ORIGINS=

# Keep false. The legacy reset route has no email/OTP verification.
ALLOW_UNVERIFIED_PASSWORD_RESET=

# Optional one-time admin bootstrap (keep secrets in local .env / host secret settings).
# ADMIN_PASSWORD must be a unique password of at least 14 characters; do not use admin@143.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
ADMIN_USERNAME=
